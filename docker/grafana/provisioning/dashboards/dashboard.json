        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 5,
      "options": {
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showTime": true,
        "sortBy": "desc"
      },
      "title": "Centralized Application Logs",
      "type": "logs",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{job=\"docker\"}",
          "refId": "A"
        }
